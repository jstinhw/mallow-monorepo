# Port the service listens on (docker compose maps host 3003 → 3002).
PORT=3002
LOG_LEVEL=info

# Required. Builds the RPC URL for every supported chain
# (1, 42161, 56, 8453, 10, 137 — see tools/contract-storage-tracer/src/chains.ts).
ALCHEMY_API_KEY=

# Advisory model — any OpenAI-compatible endpoint (LM Studio, Ollama, vLLM, OpenAI).
# Leave LLM_BASE_URL blank to serve deterministic-only verdicts instead of failing.
# From inside a container a model on the host is at http://host.docker.internal:1234/v1.
LLM_BASE_URL=
LLM_MODEL=local-model
LLM_API_KEY=

# Completion budgets, per LLM stage. These must fit the context the model is actually SERVED with,
# not what its weights support: LM Studio loads at 4096 by default and rejects any request whose
# max_tokens exceeds that, whatever the model card says. Check the served size before raising
# these (`curl localhost:1234/api/v0/models` reports loaded_context_length), and raise the
# server's context first — a 4096 window cannot hold a real trace prompt plus a reasoning budget.
LLM_ANALYZER_MAX_TOKENS=2500
LLM_SUMMARIZER_MAX_TOKENS=2500

# Model calls in flight per LLM_BASE_URL. One local server = one context budget shared by all
# concurrent requests, so a second guardian check is refused outright rather than queued; leave
# this at 1 for LM Studio/Ollama and raise it only for a server with real parallel slots.
LLM_MAX_CONCURRENCY=1

# Backward-worklist bounds for the tracer. Defaults when unset.
MAX_DEPTH=4
MAX_ADDRESSES=50

# Optional address-label service: GET {TAG_SERVICE_URL}/{address} -> { name?, labels? }.
TAG_SERVICE_URL=
