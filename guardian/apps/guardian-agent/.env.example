# Port the service listens on (docker compose maps host 3003 → 3002).
PORT=3002
LOG_LEVEL=info

# Required. Builds the RPC URL for every supported chain
# (1, 42161, 56, 8453, 10, 137 — see tools/contract-storage-tracer/src/chains.ts).
ALCHEMY_API_KEY=

# Advisory model — any OpenAI-compatible endpoint (LM Studio, Ollama, vLLM, OpenAI).
# Leave LLM_BASE_URL blank to serve deterministic-only verdicts instead of failing.
# From inside a container a model on the host is at http://host.docker.internal:1234/v1.
LLM_BASE_URL=
LLM_MODEL=local-model
LLM_API_KEY=

# Backward-worklist bounds for the tracer. Defaults when unset.
MAX_DEPTH=4
MAX_ADDRESSES=50

# Optional address-label service: GET {TAG_SERVICE_URL}/{address} -> { name?, labels? }.
TAG_SERVICE_URL=
