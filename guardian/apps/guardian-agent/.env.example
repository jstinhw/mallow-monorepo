# Port the service listens on.
PORT=3002

# Chain access. ALCHEMY_API_KEY builds the RPC URL for the supported chains;
# BSC_RPC_URL overrides the public BSC endpoint if you have a better one.
ALCHEMY_API_KEY=
BSC_RPC_URL=

# Contract source + verification lookups.
ETHERSCAN_API_KEY=

# Model provider. Any OpenAI-compatible endpoint works — Anthropic, OpenAI,
# Gemini's compatible API, or a local server. Defaults below target LM Studio.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3.6-27b

# How long to wait for the Anvil fork used for simulation to come up.
ANVIL_START_TIMEOUT_MS=30000
