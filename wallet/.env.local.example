# WalletConnect / Reown project id — required for dApp connections.
# Create one at https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Chain access. The public one is used by the browser; the server-only key
# backs the wallet's token and history API routes.
NEXT_PUBLIC_ALCHEMY_API_KEY=
ALCHEMY_API_KEY=
ETHERSCAN_API_KEY=

# Agent services the wallet talks to.
NEXT_PUBLIC_GUARDIAN_AGENT_URL=http://localhost:3003
NEXT_PUBLIC_AUTO_INVEST_AGENT_URL=http://localhost:8787
