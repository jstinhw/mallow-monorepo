# Copy to .env — docker compose reads it automatically.
# These are the variables the services actually read; the previous
# RPC_URL / PRIVATE_KEY / CONTRACT_ADDRESS names appear nowhere in the code.

# RPC provider. Used by graviton (graviton/packages/core/src/constants/chains.ts)
# and by the guardian agent's tracer.
ALCHEMY_API_KEY=

# ZeroDev bundler / paymaster
ZERODEV_API_KEY=

# Relayer signing key (0x + 64 hex chars)
RELAYER_PRIVATE_KEY=

# Guardian's advisory model — any OpenAI-compatible endpoint. Leave blank to run
# deterministic-only. From inside a container, a model on the host lives at
# http://host.docker.internal:1234/v1 (not localhost).
LLM_BASE_URL=
LLM_MODEL=local-model
LLM_API_KEY=
