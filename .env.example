# Copy to .env — docker compose reads it automatically.
# These are the variables the graviton services actually read; the previous
# RPC_URL / PRIVATE_KEY / CONTRACT_ADDRESS names appear nowhere in the code.

# RPC provider (graviton/packages/core/src/constants/chains.ts)
ALCHEMY_API_KEY=

# ZeroDev bundler / paymaster
ZERODEV_API_KEY=

# Relayer signing key (0x + 64 hex chars)
RELAYER_PRIVATE_KEY=
